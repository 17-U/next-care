# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://www.exemple.be

# Coordonnées affichées sur le site
NEXT_PUBLIC_PHONE=0470000000
NEXT_PUBLIC_PHONE_DISPLAY=0470 00 00 00

# Destinataire des demandes de prise en charge
DEMANDE_NOTIFY_EMAIL=coordination@exemple.be

# SMTP (laisser vide en developpement : les demandes sont journalisees)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=site@exemple.be
